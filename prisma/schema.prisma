// Nopedi Business Operating System — Phase 1 foundation + Tenders.
//
// Conventions (see docs/00-architecture-decisions.md):
//   - Every tenant table carries organisationId and the standard base columns.
//   - Nothing is hard deleted. deletedAt + recordStatus, enforced by the
//     Prisma extension in src/lib/database/extensions.
//   - Money is integer cents (BigInt) in ZAR. Never floats.
//   - All timestamps are timestamptz, stored UTC.
//   - Documents and compliance items are polymorphic by (entityType, entityId)
//     with no foreign key, validated at the service layer.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Lifecycle of any soft-deletable record (ADR-007).
enum RecordStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

/// Entities that can own documents, compliance items and workflow instances.
/// Adding a value here is the only way to extend the polymorphic services.
enum EntityType {
  ORGANISATION
  USER
  CUSTOMER
  CONTACT
  LEAD
  OPPORTUNITY
  TENDER
  TENDER_REQUIREMENT
  EMPLOYEE
  PROJECT
  ASSET
  SUPPLIER
  EXPENSE
  LEAVE_REQUEST
  INCIDENT
  PURCHASE_ORDER
}

enum TenderStatus {
  IDENTIFIED
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  WON
  LOST
  NO_BID
  WITHDRAWN
}

/// Where a lead came from. Deliberately a small closed set — "other" plus a
/// note beats a free-text field nobody can report on.
enum LeadSource {
  REFERRAL
  WEBSITE
  TENDER_PORTAL
  COLD_OUTREACH
  EXISTING_CLIENT
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

/// The sales pipeline. Leads live in their own table until qualified, so the
/// pipeline only ever contains things worth forecasting.
enum OpportunityStage {
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  SITE_VISIT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// What the money was spent on. Deliberately the categories a contractor
/// actually reports against, not a general ledger.
enum ExpenseCategory {
  LABOUR
  MATERIALS
  PLANT
  SUBCONTRACTOR
  TRANSPORT
  OTHER
}

/// Committed spend counts against the budget from APPROVED onward: an approved
/// purchase is money gone, whether or not the invoice has been paid.
enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum ProjectRole {
  MANAGER
  ENGINEER
  SUPERVISOR
  FOREMAN
  MEMBER
}

/// Categories for the shared expiry engine (ADR-004). One engine, many uses.
/// How someone is engaged. Drives which leave and notice rules apply, which is
/// why it is on the employee rather than inferred from a contract document.
enum EmploymentType {
  PERMANENT
  FIXED_TERM
  TEMPORARY
  CONTRACTOR
  APPRENTICE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITED
}

enum LeaveRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// How entitlement is credited to a balance over time.
///
/// The ledger came first and stays underneath: whatever credits a balance, the
/// spending rules do not change. This enum only says who does the crediting.
enum LeaveAccrualMethod {
  /// An administrator writes the entitlement. Nothing accrues on its own.
  MANUAL
  /// The whole cycle's entitlement lands on the first day of the cycle, or on
  /// the employee's first day when they join mid-cycle. Not pro-rated —
  /// choose MONTHLY_ACCRUAL for a policy that should pro-rate a joiner.
  ANNUAL_GRANT
  /// A fixed number of days for every calendar month worked in full. This is
  /// the BCEA shape: 1.25 days a month earns the statutory 15-day minimum.
  MONTHLY_ACCRUAL
}

enum ComplianceCategory {
  TRAINING
  MEDICAL
  HSE
  TENDER_DOCUMENT
  ASSET_WARRANTY
  INSURANCE
  LICENCE
  ACCREDITATION
}

/// What happened, on one scale from "nobody was touched" to "somebody died".
///
/// One field rather than a kind plus a severity, because the two can
/// contradict each other and a register that can hold "near miss, fatal" is a
/// register nobody trusts. The three at the top injure nobody; the five below
/// are the standard classification a construction safety report is written in,
/// in the order the injury got worse.
enum IncidentKind {
  NEAR_MISS
  PROPERTY_DAMAGE
  ENVIRONMENTAL
  FIRST_AID
  MEDICAL_TREATMENT
  LOST_TIME
  PERMANENT_DISABILITY
  FATALITY
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  CLOSED
}

/// The hierarchy of control, strongest first.
///
/// Recorded on every corrective action because "issue new PPE" is what a
/// closed-out action register fills up with, and it is the weakest control
/// there is — it protects one person, only while they wear it, and only from
/// the harm it was chosen for. A register that cannot show the difference is a
/// register that hides it.
enum ControlType {
  ELIMINATION
  SUBSTITUTION
  ENGINEERING
  ADMINISTRATIVE
  PPE
}

/// How a workflow step resolves its approver (ADR-006).
enum ApproverType {
  ROLE
  MANAGER
  USER
}

/// Field comparison operators for step conditions. Deliberately limited to
/// comparisons against a scalar on the triggering record.
enum ConditionOperator {
  EQ
  NEQ
  GT
  GTE
  LT
  LTE
}

enum WorkflowInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  ESCALATED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  SUBMIT
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
}

enum AccessLevel {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

// ---------------------------------------------------------------------------
// Tenancy and identity
// ---------------------------------------------------------------------------

/// The tenant root. Has no organisationId because it is the organisation.
model Organisation {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String
  tradingName        String?
  registrationNumber String?
  vatNumber          String?
  /// IANA timezone used to render every timestamp for this tenant.
  timezone           String  @default("Africa/Johannesburg")
  currency           String  @default("ZAR")

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?    @db.Timestamptz(6)

  modules            OrganisationModule[]
  publicHolidays     PublicHoliday[]
  workPatterns       WorkPattern[]
  shifts             Shift[]
  users              User[]
  roles              Role[]
  customers          Customer[]
  contacts           Contact[]
  leads              Lead[]
  opportunities      Opportunity[]
  activities         Activity[]
  projects           Project[]
  tenders            Tender[]
  documents          Document[]
  complianceItems    ComplianceItem[]
  workflowDefs       WorkflowDefinition[]
  workflowInstance   WorkflowInstance[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  sequences          ReferenceSequence[]
  employees          Employee[]
  leaveTypes         LeaveType[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  rosterAssignments  RosterAssignment[]
  patternAssignments PatternAssignment[]
  staffingRules      StaffingRule[]
  timeEntries        TimeEntry[]
  payrollPolicy      PayrollPolicy?
  incidents          Incident[]
  incidentActions    IncidentAction[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
  supplierInvoices   SupplierInvoice[]
  stockItems         StockItem[]
  stockLocations     StockLocation[]
  stockMovements     StockMovement[]
  stockCounts        StockCount[]
  stockCountLines    StockCountLine[]

  @@map("organisations")
}

/// Per-tenant module enablement (ADR-009). Navigation, routes and permission
/// checks all consult this.
model OrganisationModule {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  moduleKey      String
  isEnabled      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, moduleKey])
  @@index([organisationId])
  @@map("organisation_modules")
}

/// Local mirror of the Clerk user (ADR-002). Every foreign key in the system
/// points here, never at a Clerk identifier.
model User {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  /// Clerk's user id. The only place a vendor identifier is stored.
  clerkUserId    String? @unique
  email          String
  firstName      String
  lastName       String
  jobTitle       String?
  phone          String?
  managerId      String? @db.Uuid
  isActive       Boolean @default(true)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  manager      User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]       @relation("UserManager")

  roles                 UserRole[]
  ownedTenders          Tender[]           @relation("TenderOwner")
  uploadedVersions      DocumentVersion[]
  startedWorkflows      WorkflowInstance[] @relation("WorkflowStartedBy")
  assignedApprovals     WorkflowApproval[] @relation("ApprovalAssignee")
  decidedApprovals      WorkflowApproval[] @relation("ApprovalDecider")
  approvedTimeEntries   TimeEntry[]        @relation("TimeEntryApprover")
  stepApproverFor       WorkflowStep[]     @relation("StepApproverUser")
  stepEscalationFor     WorkflowStep[]     @relation("StepEscalationUser")
  notifications         Notification[]
  auditLogs             AuditLog[]
  ownedLeads            Lead[]             @relation("LeadOwner")
  ownedOpportunities    Opportunity[]      @relation("OpportunityOwner")
  activities            Activity[]         @relation("ActivityOwner")
  managedProjects       Project[]          @relation("ProjectManager")
  projectMemberships    ProjectMember[]
  assignedTasks         ProjectTask[]      @relation("TaskAssignee")
  submittedExpenses     ProjectExpense[]   @relation("ExpenseSubmitter")
  approvedExpenses      ProjectExpense[]   @relation("ExpenseApprover")
  employeeRecord        Employee?
  decidedLeave          LeaveRequest[]     @relation("LeaveDecider")
  investigatedIncidents Incident[]         @relation("IncidentInvestigator")
  closedIncidents       Incident[]         @relation("IncidentCloser")
  completedActions      IncidentAction[]   @relation("IncidentActionCompleter")
  submittedOrders       PurchaseOrder[]    @relation("PurchaseOrderSubmitter")
  approvedOrders        PurchaseOrder[]    @relation("PurchaseOrderApprover")
  submittedStockCounts  StockCount[]       @relation("StockCountSubmitter")
  acceptedStockCounts   StockCount[]       @relation("StockCountAcceptor")

  @@unique([organisationId, email])
  @@index([organisationId])
  @@index([managerId])
  @@map("users")
}

/// Roles are per tenant, so Nopedi can name and shape their own.
model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  key            String
  name           String
  description    String?
  /// System roles are seeded and cannot be deleted by users.
  isSystem       Boolean @default(false)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  permissions       RolePermission[]
  users             UserRole[]
  stepApproverFor   WorkflowStep[]     @relation("StepApproverRole")
  assignedApprovals WorkflowApproval[] @relation("ApprovalAssigneeRole")

  @@unique([organisationId, key])
  @@index([organisationId])
  @@map("roles")
}

/// The global permission catalogue. Not tenant scoped — these are the verbs
/// the software supports, identical for every customer.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  moduleKey   String
  description String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@index([moduleKey])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  createdBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Per-organisation, per-year counters behind human-facing reference numbers
/// such as TN-2026-0041.
model ReferenceSequence {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  prefix         String
  year           Int
  lastNumber     Int    @default(0)

  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, prefix, year])
  @@map("reference_sequences")
}

// ---------------------------------------------------------------------------
// Shared business entities
// ---------------------------------------------------------------------------

model Customer {
  id                 String  @id @default(uuid()) @db.Uuid
  organisationId     String  @db.Uuid
  name               String
  registrationNumber String?
  vatNumber          String?
  email              String?
  phone              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  province           String?
  postalCode         String?
  countryCode        String  @default("ZA")
  /// True for organs of state, which carry extra tender compliance rules.
  isPublicSector     Boolean @default(false)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tenders            Tender[]
  contacts           Contact[]
  opportunities      Opportunity[]
  projects           Project[]
  convertedFromLeads Lead[]        @relation("LeadConvertedCustomer")

  @@index([organisationId])
  @@index([organisationId, name])
  @@map("customers")
}

/// A person at a customer. Separate from User: these are people we sell to,
/// not people who sign in.
model Contact {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  customerId     String  @db.Uuid
  firstName      String
  lastName       String
  jobTitle       String?
  email          String?
  phone          String?
  /// The default person to contact. Enforced in the service, not the schema —
  /// a partial unique index would block the common "swap the primary" edit.
  isPrimary      Boolean @default(false)
  notes          String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([organisationId])
  @@index([customerId])
  @@map("contacts")
}

/// An unqualified enquiry. Lives outside the pipeline until it is qualified,
/// so forecast figures are never inflated by things nobody has spoken to yet.
model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  organisationId String     @db.Uuid
  reference      String
  companyName    String
  contactName    String?
  email          String?
  phone          String?
  source         LeadSource @default(OTHER)
  sourceDetail   String?
  status         LeadStatus @default(NEW)
  description    String?

  estimatedValueCents BigInt?
  ownerId             String? @db.Uuid

  /// Set when the lead becomes a customer and an opportunity. Both are
  /// recorded so the trail from enquiry to revenue stays intact.
  convertedAt            DateTime? @db.Timestamptz(6)
  convertedCustomerId    String?   @db.Uuid
  convertedOpportunityId String?   @db.Uuid
  disqualifiedReason     String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner                User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedCustomer    Customer?    @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity? @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("leads")
}

/// A qualified deal being worked. This is what the forecast is built from.
model Opportunity {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  reference      String
  title          String
  description    String?
  customerId     String  @db.Uuid
  contactId      String? @db.Uuid
  ownerId        String? @db.Uuid

  valueCents      BigInt?
  currency        String           @default("ZAR")
  /// 0-100. Weighted pipeline is value × probability, computed in SQL.
  probability     Int              @default(50)
  expectedCloseAt DateTime?        @db.Timestamptz(6)
  stage           OpportunityStage @default(QUALIFIED)
  source          LeadSource?

  /// The tender this opportunity is being pursued through, when there is one.
  /// A public-sector deal is usually both: a relationship and a bid.
  tenderId String? @db.Uuid

  closedAt   DateTime? @db.Timestamptz(6)
  lostReason String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User?        @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tender       Tender?      @relation(fields: [tenderId], references: [id], onDelete: SetNull)

  convertedFromLead Lead[]    @relation("LeadConvertedOpportunity")
  projects          Project[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, stage])
  @@index([organisationId, expectedCloseAt])
  @@index([customerId])
  @@map("opportunities")
}

/// Calls, emails, meetings and notes. Polymorphic like documents (ADR-003), so
/// the same timeline serves leads, customers, contacts and opportunities — and
/// later projects and tenders without a second table.
model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  entityType     EntityType
  entityId       String       @db.Uuid
  type           ActivityType
  subject        String
  body           String?
  occurredAt     DateTime     @default(now()) @db.Timestamptz(6)
  ownerId        String?      @db.Uuid

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, entityType, entityId, occurredAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Tenders
// ---------------------------------------------------------------------------

model Tender {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  /// Our reference, e.g. TN-2026-0041. Unique per tenant.
  reference      String
  /// The client's own tender number, as printed on their documents.
  tenderNumber   String?
  title          String
  description    String?
  customerId     String? @db.Uuid
  ownerId        String? @db.Uuid

  closingAt           DateTime     @db.Timestamptz(6)
  estimatedValueCents BigInt?
  currency            String       @default("ZAR")
  industry            String?
  status              TenderStatus @default(IDENTIFIED)

  submittedAt       DateTime? @db.Timestamptz(6)
  outcomeAt         DateTime? @db.Timestamptz(6)
  awardedValueCents BigInt?
  outcomeNotes      String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner        User?        @relation("TenderOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  requirements  TenderRequirement[]
  opportunities Opportunity[]
  projects      Project[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, closingAt])
  @@map("tenders")
}

/// One line of the submission checklist. A tender cannot be submitted while a
/// mandatory requirement is unsatisfied — enforced in the service, not the UI.
model TenderRequirement {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  tenderId       String  @db.Uuid
  label          String
  description    String?
  isMandatory    Boolean @default(true)
  sortOrder      Int     @default(0)

  satisfiedAt DateTime? @db.Timestamptz(6)
  satisfiedBy String?   @db.Uuid
  /// Optional link to the document that satisfies this requirement.
  documentId  String?   @db.Uuid
  notes       String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  tender   Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([tenderId])
  @@map("tender_requirements")
}

// ---------------------------------------------------------------------------
// Projects — delivery, and where a won bid becomes work
// ---------------------------------------------------------------------------

/// A project is the central object of delivery. It carries the thread from
/// where the work came from: the customer, and optionally the opportunity and
/// tender it was won through. Nobody retypes the client.
model Project {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  reference      String
  name           String
  description    String?
  customerId     String  @db.Uuid
  /// The bid this was won through, when there was one.
  tenderId       String? @db.Uuid
  opportunityId  String? @db.Uuid
  managerId      String? @db.Uuid

  status   ProjectStatus @default(PLANNING)
  startsAt DateTime?     @db.Timestamptz(6)
  endsAt   DateTime?     @db.Timestamptz(6)
  closedAt DateTime?     @db.Timestamptz(6)

  /// What the client pays. Revenue.
  contractValueCents BigInt?
  /// What we have allowed ourselves to spend. Cost.
  budgetCents        BigInt?
  currency           String  @default("ZAR")

  /// 0-100, entered by the project manager rather than derived from tasks:
  /// task counts are a poor proxy for physical progress on site.
  percentComplete Int @default(0)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tender       Tender?      @relation(fields: [tenderId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  members           ProjectMember[]
  tasks             ProjectTask[]
  milestones        ProjectMilestone[]
  expenses          ProjectExpense[]
  rosterAssignments RosterAssignment[]
  staffingRules     StaffingRule[]
  timeEntries       TimeEntry[]
  incidents         Incident[]
  purchaseOrders    PurchaseOrder[]
  stockLocations    StockLocation[]
  stockIssues       StockMovement[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([customerId])
  @@map("projects")
}

/// Who is on the project, and how much of them we have.
model ProjectMember {
  id             String      @id @default(uuid()) @db.Uuid
  organisationId String      @db.Uuid
  projectId      String      @db.Uuid
  userId         String      @db.Uuid
  role           ProjectRole @default(MEMBER)
  /// Percentage of this person's time committed to the project.
  allocation     Int         @default(100)
  joinedAt       DateTime    @default(now()) @db.Timestamptz(6)
  leftAt         DateTime?   @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organisationId])
  @@index([userId])
  @@map("project_members")
}

model ProjectMilestone {
  id                 String    @id @default(uuid()) @db.Uuid
  organisationId     String    @db.Uuid
  projectId          String    @db.Uuid
  name               String
  description        String?
  dueAt              DateTime? @db.Timestamptz(6)
  completedAt        DateTime? @db.Timestamptz(6)
  sortOrder          Int       @default(0)
  /// Payment milestones drive invoicing, so they are marked as such.
  isPaymentMilestone Boolean   @default(false)
  valueCents         BigInt?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([organisationId])
  @@index([projectId])
  @@map("project_milestones")
}

model ProjectTask {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  projectId      String       @db.Uuid
  milestoneId    String?      @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?      @db.Uuid
  dueAt          DateTime?    @db.Timestamptz(6)
  completedAt    DateTime?    @db.Timestamptz(6)
  /// Set when a task is BLOCKED, so a stalled project explains itself.
  blockedReason  String?
  sortOrder      Int          @default(0)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@map("project_tasks")
}

/// Cost booked against a project. Approved and paid expenses both count as
/// committed spend, because an approved cost is money gone.
model ProjectExpense {
  id             String          @id @default(uuid()) @db.Uuid
  organisationId String          @db.Uuid
  projectId      String          @db.Uuid
  reference      String
  description    String
  category       ExpenseCategory @default(OTHER)
  amountCents    BigInt
  currency       String          @default("ZAR")
  status         ExpenseStatus   @default(DRAFT)
  incurredAt     DateTime        @db.Timestamptz(6)
  supplierName   String?

  submittedById  String?   @db.Uuid
  approvedById   String?   @db.Uuid
  approvedAt     DateTime? @db.Timestamptz(6)
  rejectedReason String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User?   @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy  User?   @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([projectId, status])
  @@map("project_expenses")
}

// ---------------------------------------------------------------------------
// Documents (ADR-003) — a platform service, not a module
// ---------------------------------------------------------------------------

model Document {
  id             String     @id @default(uuid()) @db.Uuid
  organisationId String     @db.Uuid
  /// Polymorphic owner. No foreign key; validated at the service layer.
  entityType     EntityType
  entityId       String     @db.Uuid

  name           String
  category       String?
  accessLevel    AccessLevel @default(INTERNAL)
  /// Pointer to the newest version, kept for cheap listing.
  currentVersion Int         @default(0)
  /// Set when the document itself expires, e.g. a tax clearance certificate.
  expiresAt      DateTime?   @db.Timestamptz(6)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]
  requirements TenderRequirement[]
  compliance   ComplianceItem[]

  @@index([organisationId])
  @@index([organisationId, entityType, entityId])
  @@index([organisationId, expiresAt])
  @@map("documents")
}

/// The physical files. A document is the logical thing; versions are the bytes.
/// Only the storage key is persisted — never a signed URL.
model DocumentVersion {
  id            String @id @default(uuid()) @db.Uuid
  documentId    String @db.Uuid
  versionNumber Int

  /// org/{organisationId}/{entityType}/{entityId}/{documentId}/v{n}/{filename}
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  checksum   String?

  uploadedById String?  @db.Uuid
  uploadedAt   DateTime @default(now()) @db.Timestamptz(6)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

// ---------------------------------------------------------------------------
// Compliance / expiry engine (ADR-004) — one engine, used everywhere
// ---------------------------------------------------------------------------

/// Anything with an expiry date and a computed status. Deliberately generic so
/// training, medicals, HSE, tender documents, warranties and insurance all
/// share one engine and one notification schedule.
///
/// There is no status column. Status is derived from expiresAt at read time,
/// because a stored status goes stale the moment nothing writes to it.
model ComplianceItem {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @db.Uuid
  category       ComplianceCategory
  /// Polymorphic owner: an employee, an asset, the organisation itself.
  entityType     EntityType
  entityId       String             @db.Uuid

  requirementName   String
  certificateNumber String?
  issuedAt          DateTime? @db.Timestamptz(6)
  expiresAt         DateTime? @db.Timestamptz(6)
  providerName      String?
  documentId        String?   @db.Uuid
  notes             String?

  /// Highest expiry warning already sent, in days. Prevents duplicate sends.
  lastWarningDays Int?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, entityType, entityId])
  @@index([organisationId, expiresAt])
  @@index([organisationId, category])
  @@map("compliance_items")
}

// ---------------------------------------------------------------------------
// Approval engine (ADR-006) — linear steps, scalar conditions, nothing more
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id             String     @id @default(uuid()) @db.Uuid
  organisationId String     @db.Uuid
  name           String
  entityType     EntityType
  /// Event that starts this workflow, e.g. "tender.submitted".
  triggerEvent   String
  isActive       Boolean    @default(true)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  instances    WorkflowInstance[]

  @@unique([organisationId, entityType, triggerEvent])
  @@index([organisationId])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id                   String       @id @default(uuid()) @db.Uuid
  organisationId       String       @db.Uuid
  workflowDefinitionId String       @db.Uuid
  sortOrder            Int
  name                 String
  approverType         ApproverType

  approverRoleId   String? @db.Uuid
  approverUserId   String? @db.Uuid
  escalationUserId String? @db.Uuid
  slaHours         Int?

  /// Scalar condition on the triggering record. Null means the step always
  /// applies. Cross-entity conditions are deliberately out of scope.
  conditionField    String?
  conditionOperator ConditionOperator?
  conditionValue    String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  definition     WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  approverRole   Role?              @relation("StepApproverRole", fields: [approverRoleId], references: [id], onDelete: SetNull)
  approverUser   User?              @relation("StepApproverUser", fields: [approverUserId], references: [id], onDelete: SetNull)
  escalationUser User?              @relation("StepEscalationUser", fields: [escalationUserId], references: [id], onDelete: SetNull)

  approvals WorkflowApproval[]

  @@unique([workflowDefinitionId, sortOrder])
  @@index([organisationId])
  @@map("workflow_steps")
}

/// A running approval against one specific record.
model WorkflowInstance {
  id                   String     @id @default(uuid()) @db.Uuid
  organisationId       String     @db.Uuid
  workflowDefinitionId String     @db.Uuid
  entityType           EntityType
  entityId             String     @db.Uuid

  status           WorkflowInstanceStatus @default(PENDING)
  currentStepOrder Int                    @default(0)
  startedById      String?                @db.Uuid
  startedAt        DateTime               @default(now()) @db.Timestamptz(6)
  completedAt      DateTime?              @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  definition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  startedBy    User?              @relation("WorkflowStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  approvals WorkflowApproval[]

  @@index([organisationId])
  @@index([organisationId, entityType, entityId])
  @@index([organisationId, status])
  @@map("workflow_instances")
}

/// One approver's decision on one step of one instance.
model WorkflowApproval {
  id                 String @id @default(uuid()) @db.Uuid
  organisationId     String @db.Uuid
  workflowInstanceId String @db.Uuid
  workflowStepId     String @db.Uuid
  sortOrder          Int

  status           WorkflowApprovalStatus @default(PENDING)
  assignedToUserId String?                @db.Uuid
  assignedToRoleId String?                @db.Uuid
  decidedByUserId  String?                @db.Uuid
  decidedAt        DateTime?              @db.Timestamptz(6)
  comment          String?
  dueAt            DateTime?              @db.Timestamptz(6)
  escalatedAt      DateTime?              @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  instance       WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  step           WorkflowStep     @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  assignedToUser User?            @relation("ApprovalAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToRole Role?            @relation("ApprovalAssigneeRole", fields: [assignedToRoleId], references: [id], onDelete: SetNull)
  decidedBy      User?            @relation("ApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([workflowInstanceId])
  @@index([organisationId, status, assignedToUserId])
  @@index([organisationId, status, assignedToRoleId])
  @@map("workflow_approvals")
}

// ---------------------------------------------------------------------------
// Platform services
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  organisationId String              @db.Uuid
  userId         String              @db.Uuid
  channel        NotificationChannel @default(IN_APP)
  /// Dotted event key, e.g. "tender.approval.requested".
  event          String
  title          String
  body           String?

  entityType EntityType?
  entityId   String?     @db.Uuid
  /// Deep link into the app.
  href       String?

  readAt       DateTime? @db.Timestamptz(6)
  sentAt       DateTime? @db.Timestamptz(6)
  /// Set when a channel delivery fails, for retry and debugging.
  failedReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Append only. Never updated, never soft deleted, no deletedAt by design.
/// Written by the Prisma extension so it cannot be forgotten in new modules.
model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organisationId String      @db.Uuid
  actorUserId    String?     @db.Uuid
  action         AuditAction
  /// The Prisma model name, e.g. "Tender". Deliberately a string rather than
  /// EntityType: audit covers every model, whereas EntityType is the narrow
  /// set of things documents and compliance items can hang off.
  entityType     String
  /// String rather than uuid so composite keys can be recorded too.
  entityId       String

  /// { field: { from, to } } for updates; the full record for creates.
  changes Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([organisationId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// HR — people, certifications and leave
// ---------------------------------------------------------------------------

/// A person the organisation employs.
///
/// Deliberately not the same record as `User`. A user is someone who can sign
/// in; an employee is someone on the payroll. Most site staff are employees
/// with no login, and an external auditor may be a user who is not an
/// employee. Collapsing the two is the mistake that later forces either fake
/// logins for people who will never use the system, or employee data hanging
/// off accounts that get deactivated.
model Employee {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  /// EMP-2026-0001. Generated, so nobody has to invent a numbering scheme.
  employeeNumber String
  /// Present only when this person also has a login.
  userId         String? @db.Uuid

  firstName String
  lastName  String
  email     String?
  phone     String?

  /// South African ID or passport. Stored because leave, HSE and statutory
  /// reporting all key off it. POPIA applies: see docs/02-discovery-questions.
  nationalId String?

  jobTitle   String?
  department String?
  /// Who they report to, as an employee. Separate from User.managerId, which
  /// is about system hierarchy and may differ for contractors.
  managerId  String? @db.Uuid

  employmentType EmploymentType @default(PERMANENT)
  /// Which days they work. Null means the tenant's default pattern.
  workPatternId  String?        @db.Uuid
  /// Which hours they work them on, when that differs from the pattern's own
  /// shift. The same six-day pattern is worked on days by one crew and nights
  /// by another, and a rotation swaps the shift while the days stay put — so
  /// the shift cannot live only on the pattern.
  ///
  /// Both this and workPatternId are the *current* answer, written by the
  /// rotation and read everywhere. The history is in pattern_assignments.
  shiftId        String?        @db.Uuid
  status         EmployeeStatus @default(ACTIVE)
  startedAt      DateTime       @db.Timestamptz(6)
  /// Set on exit. The record is never deleted — statutory retention applies.
  endedAt        DateTime?      @db.Timestamptz(6)
  exitReason     String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      Employee[]   @relation("EmployeeManager")
  workPattern  WorkPattern? @relation(fields: [workPatternId], references: [id], onDelete: SetNull)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  rosterAssignments  RosterAssignment[]
  patternAssignments PatternAssignment[]
  timeEntries        TimeEntry[]
  injuries           Incident[]          @relation("IncidentInjured")
  safetyActions      IncidentAction[]    @relation("IncidentActionOwner")
  goodsReceived      GoodsReceipt[]      @relation("GoodsReceiver")
  stockIssuedTo      StockMovement[]     @relation("StockIssuedTo")
  stockCounted       StockCount[]        @relation("StockCounter")

  @@unique([organisationId, employeeNumber])
  @@unique([userId])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([managerId])
  @@map("employees")
}

/// A kind of leave, and the entitlement that comes with it.
///
/// This is configuration rather than code on purpose. South African leave is
/// set by the BCEA as a floor, then raised by a bargaining council agreement
/// or company policy, and we do not yet know which apply to Nopedi
/// (docs/02-discovery-questions.md). Encoding the rules as rows means the
/// answer changes data, not the data model.
model LeaveType {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  code           String
  name           String
  description    String?

  /// Entitlement per cycle. Null means uncapped — unpaid leave, typically.
  daysPerCycle              Decimal? @db.Decimal(6, 2)
  isPaid                    Boolean  @default(true)
  /// Days that may be carried into the next cycle. Null means none.
  carryOverMaxDays          Decimal? @db.Decimal(6, 2)
  /// Sick leave over two consecutive days needs a medical certificate under
  /// the BCEA. Expressed as a threshold so a stricter policy is a row edit.
  documentRequiredAfterDays Int?
  /// Whether a request may be backdated. Sick leave usually is; annual is not.
  allowsBackdating          Boolean  @default(false)

  /// How this type's entitlement is credited. MANUAL is the default because
  /// it is what every existing row did before accrual existed, and a migration
  /// that silently started crediting days would rewrite people's balances.
  accrualMethod        LeaveAccrualMethod @default(MANUAL)
  /// Days credited per completed month under MONTHLY_ACCRUAL. Ignored by the
  /// other methods, which take their figure from daysPerCycle.
  accrualDaysPerPeriod Decimal?           @db.Decimal(6, 2)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("leave_types")
}

/// What one employee is entitled to, and has taken, in one cycle.
///
/// A ledger, not an accrual engine. How entitlement is topped up — monthly
/// accrual, annual grant, the BCEA's 36-month sick cycle — depends on answers
/// we do not have, so the balance is written to rather than computed. When the
/// rules arrive they populate this table; nothing that reads it has to change.
model LeaveBalance {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  employeeId     String @db.Uuid
  leaveTypeId    String @db.Uuid

  cycleStartsAt DateTime @db.Timestamptz(6)
  cycleEndsAt   DateTime @db.Timestamptz(6)

  entitledDays       Decimal @default(0) @db.Decimal(6, 2)
  /// Carried in from the previous cycle, kept separate so it can be reported.
  broughtForwardDays Decimal @default(0) @db.Decimal(6, 2)
  /// Approved and taken. Pending requests are not counted here — they are
  /// counted at request time, so two overlapping requests cannot both fit.
  takenDays          Decimal @default(0) @db.Decimal(6, 2)

  /// The date up to which accrual has already credited this balance. It is
  /// what makes a run idempotent: the engine credits the periods between this
  /// and today, so running it twice in one day changes nothing. Null means
  /// nothing has accrued yet — a hand-written entitlement leaves it null.
  accruedThroughAt DateTime? @db.Timestamptz(6)
  /// Why the entitlement is what it is, when a person set it. The audit log
  /// records who and when; this records the reason they gave.
  notes            String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  /// organisationId leads the key so the tenancy extension can pin an
  /// upsert to one tenant. Without it the guard refuses the write, which
  /// is the extension doing its job rather than being awkward.
  @@unique([organisationId, employeeId, leaveTypeId, cycleStartsAt])
  @@index([organisationId])
  @@index([organisationId, employeeId])
  @@map("leave_balances")
}

/// A named stretch of the day: days, nights, the Saturday half-day.
///
/// Separate from the pattern on purpose. A pattern says *which days*; a shift
/// says *which hours*. The same six-day pattern is worked on days by one crew
/// and nights by another, and a rotation swaps the shift while the days stay
/// put — one table each keeps that from becoming a combinatorial mess of
/// "six-day days", "six-day nights", "six-day afternoons".
///
/// Times are minutes from midnight rather than DateTimes, because a shift is a
/// time of day and not a moment: 18:00 means 18:00 on whichever date it is
/// worked, in the tenant's timezone, which no timestamp can express.
model Shift {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  code           String
  name           String
  description    String?

  /// Minutes from midnight. 420 is 07:00.
  startsAtMinutes Int
  /// Minutes from midnight. When it is not after the start, the shift crosses
  /// midnight and ends the following morning — which is what a night shift is.
  endsAtMinutes   Int
  /// Unpaid break, subtracted from the hours a shift is worth.
  breakMinutes    Int @default(0)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation  Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  patterns      WorkPattern[]
  employees     Employee[]
  assignments   PatternAssignment[]
  staffingRules StaffingRule[]
  timeEntries   TimeEntry[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("shifts")
}

/// Which days somebody actually works.
///
/// Monday to Friday was hard-coded until this existed, and it is wrong for
/// most of a construction payroll: site staff commonly work a six-day week,
/// and a plant operator on a rotation works fourteen days on and seven off.
/// Every one of them was being charged five days of leave for a week they
/// would have worked six, or granted a Saturday they were rostered for.
///
/// Expressed as a repeating cycle rather than seven booleans so a fortnightly
/// rotation is the same shape as an ordinary week: `cycleDays` long, with
/// `workingDayIndexes` saying which positions in it are worked, counted from
/// `anchorOn`. A seven-day cycle anchored on a Monday makes index 0 Monday,
/// which is the ordinary case and reads as such.
model WorkPattern {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  code           String
  name           String
  description    String?

  /// 7 for a weekly pattern, 14 for a fortnightly rotation.
  cycleDays         Int      @default(7)
  /// Positions in the cycle that are worked, 0-indexed from anchorOn.
  workingDayIndexes Int[]
  /// The day index 0 falls on. Irrelevant for a weekly pattern anchored on a
  /// Monday, and the whole story for a rotation.
  anchorOn          DateTime @db.Timestamptz(6)
  /// Informational for leave, which is counted in days. Timesheets and
  /// overtime will need it, and recording it now costs nothing.
  hoursPerDay       Decimal  @default(8) @db.Decimal(4, 2)

  /// The shift worked on this pattern's days. Null means the hours are not
  /// specified — true of an office pattern where nobody clocks in.
  shiftId String? @db.Uuid

  /// How long a turn on this pattern lasts before people are rotated off it,
  /// in weeks. Null is a standing pattern nobody rotates off — the office
  /// week, and most of the payroll. It sets the default end date when the
  /// pattern is assigned; it does not move anybody on its own.
  rotationWeeks Int?

  /// How many turns in a row on this pattern is too many for one person.
  ///
  /// Null exempts the pattern from the fairness watch, which is what an office
  /// weekday pattern wants: nobody is hard done by a fourth Monday-to-Friday
  /// month. On nights or a six-day week it is the number that decides when the
  /// system says something — and it only ever says something. Refusing the
  /// assignment would put a rule between a foreman and a crew he has to staff
  /// tonight, and he would work around it by not recording the truth.
  maxConsecutiveTurns Int?

  /// The pattern used by anybody who has not been given one of their own.
  /// Exactly one per tenant, enforced by the service rather than the schema,
  /// because a partial unique index on a boolean is a poor trade for a rule
  /// that has to be explained in an error message anyway.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  shift        Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  employees    Employee[]
  assignments  PatternAssignment[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("work_patterns")
}

/// A turn on a pattern: who worked which pattern, on which shift, from when.
///
/// The employee row carries the *current* pattern and shift, because every
/// screen and every leave calculation asks that question and none of them
/// should have to reconstruct it. This table is the history behind it, and it
/// exists for three things the single pointer cannot do.
///
/// It answers "since when", which matters the moment somebody disputes a
/// payslip. It lets the next turn be written before it starts, so next month's
/// rotation is decided while the foreman has the crew in front of him rather
/// than at 05:00 on the day. And it is what the fairness watch reads: whether
/// this person has drawn nights three turns running is a question about the
/// past, and a system that only stores the present cannot answer it.
model PatternAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  employeeId     String  @db.Uuid
  workPatternId  String  @db.Uuid
  /// The hours worked on it. Null takes the pattern's own shift.
  shiftId        String? @db.Uuid

  /// First day of the turn, at UTC midnight.
  startsOn  DateTime  @db.Timestamptz(6)
  /// Last day of it. Null is an open-ended turn, which a standing pattern is.
  endsOn    DateTime? @db.Timestamptz(6)
  /// When the employee row was actually pointed at this pattern. Null means
  /// the turn is still in the future and has not taken effect yet.
  appliedAt DateTime? @db.Timestamptz(6)
  /// Why, where a reason exists: "covering Sipho's leave", "crane ticket".
  note      String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workPattern  WorkPattern  @relation(fields: [workPatternId], references: [id], onDelete: Cascade)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, startsOn])
  @@index([employeeId, startsOn])
  @@map("pattern_assignments")
}

/// Somebody placed on a site for a stretch of days.
///
/// The roster answers "who is where next week", which is a different question
/// from "who is on the project team". Team membership is a standing fact about
/// a project; an assignment is a date range, and the same person appears on
/// several across a month.
///
/// Stored as a range rather than a row per day: a fortnight on one site is one
/// decision and should survive as one record, and the days it actually covers
/// are computed from the person's work pattern, which already knows they do
/// not work Sundays.
model RosterAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  organisationId String  @db.Uuid
  employeeId     String  @db.Uuid
  /// Where they are. Null is a placement with no project — a yard day, or
  /// training — which still has to be visible or the roster lies about who is
  /// available.
  projectId      String? @db.Uuid

  startsAt DateTime @db.Timestamptz(6)
  endsAt   DateTime @db.Timestamptz(6)
  /// What they are there to do. Free text on purpose: "night shift", "crane
  /// escort", "standby" — a closed list would be wrong within a week.
  note     String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, startsAt])
  @@index([employeeId, startsAt])
  @@map("roster_assignments")
}

/// One stretch of time somebody was actually at work.
///
/// Everything else in Work cycles is a plan: the pattern says which days
/// somebody should work, the shift says which hours, the roster says where.
/// This is the only record of what happened, and it is a separate table for
/// exactly that reason — reconciling the two is the point, and a plan that
/// overwrites itself with reality can no longer be compared to it.
///
/// Stored as two moments rather than a duration, because "when did you leave"
/// is the question in dispute when a payslip is queried, and a number of hours
/// cannot answer it. The minutes worked are derived, never stored: a stored
/// total is one more thing that can disagree with the times beside it.
model TimeEntry {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  employeeId     String @db.Uuid

  /// The working day this belongs to, at UTC midnight.
  ///
  /// A night shift starting at 18:00 on Tuesday and ending at 06:00 on
  /// Wednesday is Tuesdays work, and paying it against Wednesday would put
  /// half a construction payroll on the wrong week. Derived from the moment
  /// they clocked in, and stored so a day can be looked up without arithmetic.
  workedOn DateTime @db.Timestamptz(6)

  clockedInAt  DateTime  @db.Timestamptz(6)
  /// Null while somebody is still on the clock.
  clockedOutAt DateTime? @db.Timestamptz(6)
  /// Unpaid break, subtracted from the time between the two moments.
  breakMinutes Int       @default(0)

  /// Where they were, when it is known. Taken from the roster at clock-in.
  projectId String? @db.Uuid
  /// The shift they were on, for comparing what was worked to what was planned.
  shiftId   String? @db.Uuid

  note String?

  /// Signed off for payroll. Nothing is paid from an unapproved entry, and an
  /// approved one is not edited — a correction after that is a new entry with
  /// a reason on it, so the trail survives the disagreement.
  approvedAt   DateTime? @db.Timestamptz(6)
  approvedById String?   @db.Uuid

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("TimeEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, workedOn])
  @@index([employeeId, workedOn])
  @@map("time_entries")
}

/// How this tenant splits worked hours for payroll.
///
/// One row per tenant, and every number in it is a policy rather than a fact
/// about the software. The defaults are the BCEA's: 45 ordinary hours a week,
/// nine a day on a five-day week and eight on anything longer, overtime at
/// one-and-a-half, Sundays and public holidays at double. A bargaining council
/// agreement raises any of them, and which one binds Nopedi is still open
/// (docs/02-discovery-questions.md), so they are rows an administrator edits.
///
/// What is deliberately not here is anybody's pay rate. The export says how
/// many hours fell into each category and stops; the payroll package holds the
/// rates and does the multiplication. That keeps salaries out of a database
/// that has not yet cleared the RLS and MFA gate, and it is also how every
/// South African payroll package expects to be fed.
model PayrollPolicy {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid

  /// Ordinary hours before overtime starts, on a week of five days or fewer.
  ordinaryMinutesPerDayShortWeek Int @default(540)
  /// The same, for somebody working six days — the BCEA's eight-hour day.
  ordinaryMinutesPerDayLongWeek  Int @default(480)
  /// Ordinary hours in a week, whatever the daily split. 45 hours.
  ordinaryMinutesPerWeek         Int @default(2700)

  /// The most overtime the BCEA allows before it stops being lawful. Exceeding
  /// these does not stop an export — the hours were worked and payroll still
  /// has to pay them — but every breach is reported.
  maxOvertimeMinutesPerDay  Int @default(180)
  maxOvertimeMinutesPerWeek Int @default(600)

  /// What each category is worth, as a multiplier of the ordinary rate. Held
  /// so the export can carry them for the payroll package to apply; nothing
  /// here multiplies anything by money.
  overtimeMultiplier Decimal @default(1.5) @db.Decimal(4, 2)
  sundayMultiplier   Decimal @default(2.0) @db.Decimal(4, 2)
  holidayMultiplier  Decimal @default(2.0) @db.Decimal(4, 2)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId])
  @@map("payroll_policies")
}

/// How many people a site, a trade or the company needs on a given day.
///
/// "Are we short on Tuesday" is a question nobody could ask this system: it
/// knew who was rostered and who was on leave, and had no idea how many were
/// supposed to be there. The number is a row rather than a constant because it
/// is a judgement that changes weekly — a concrete pour needs eight, the same
/// site needs three the week after — and because the person who knows it is a
/// site manager rather than whoever deploys.
///
/// Deliberately not a shift-by-shift schedule. That is a different and much
/// larger thing (every day of every week planned individually), and most of
/// what it buys is already here: the pattern says who is due in, the roster
/// says where, and this says how many are wanted. If somebody later needs the
/// full schedule, these rules are the floor it would be built on.
model StaffingRule {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  name           String

  /// The site it is about. Null is a rule about the whole company.
  projectId  String? @db.Uuid
  /// The trade or department it counts. Null counts everybody.
  department String?
  /// The shift it counts. Null counts whoever is due in, whatever the hours.
  shiftId    String? @db.Uuid

  /// Days the rule applies to, 0 = Monday. Empty means every day — the
  /// working pattern already decides which of those anybody is due in on, so
  /// a rule does not have to repeat it.
  weekdays Int[]

  /// Below this, the day is short.
  minimumPeople Int
  /// Above this, the day is overstaffed. Null means no ceiling, which is the
  /// honest answer for most sites: too many hands is a cost, not a failure.
  maximumPeople Int?

  isActive Boolean @default(true)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shift        Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@map("staffing_rules")
}

/// A day the company does not work, and therefore does not charge to leave.
///
/// Per tenant, not global, because half of them are not statutory: a builders'
/// shutdown between Christmas and New Year is a company decision, and an
/// election day is declared by the President a few weeks beforehand. Both have
/// to be addable without a deployment, which means rows.
///
/// The statutory twelve are generated rather than typed — including Good
/// Friday and Family Day, which move with Easter, and the Public Holidays Act
/// rule that a holiday falling on a Sunday is observed on the Monday.
model PublicHoliday {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  /// The day itself, at UTC midnight. Where a Sunday holiday is observed on
  /// the Monday, this is the Monday — the day nobody comes to work.
  observedOn     DateTime @db.Timestamptz(6)
  name           String
  /// False for a company shutdown or anything else Nopedi chose themselves.
  isStatutory    Boolean  @default(true)
  notes          String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, observedOn])
  @@index([organisationId])
  @@index([organisationId, observedOn])
  @@map("public_holidays")
}

/// A request to be away, and its decision.
model LeaveRequest {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  reference      String
  employeeId     String @db.Uuid
  leaveTypeId    String @db.Uuid

  startsAt DateTime @db.Timestamptz(6)
  endsAt   DateTime @db.Timestamptz(6)
  /// Working days, computed on submission and stored. Recomputing it later
  /// would silently rewrite history when the working-day rules change.
  days     Decimal  @db.Decimal(6, 2)
  reason   String?

  status          LeaveRequestStatus @default(SUBMITTED)
  decidedById     String?            @db.Uuid
  decidedAt       DateTime?          @db.Timestamptz(6)
  decisionComment String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([employeeId, startsAt])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Health and safety (OHSA 85 of 1993, Construction Regulations 2014)
// ---------------------------------------------------------------------------

/// Something that went wrong, or nearly did.
///
/// Near misses are in the same table as fatalities on purpose. They are the
/// same event with a different amount of luck in it, and a register that only
/// holds the ones that drew blood has thrown away every warning it was given.
/// The classification decides what happens next; it does not decide whether
/// the thing is worth writing down.
///
/// Two statutory duties hang off these rows and they are not the same duty:
/// section 24 of the OHSA reports to the Department of Employment and Labour,
/// and section 39 of COIDA reports to the Compensation Fund. An incident can
/// owe one, both or neither. Which is which is worked out in
/// `src/modules/hse/reportability.ts` rather than stored, so that correcting
/// the rules corrects the whole register rather than only the rows filed after
/// the fix.
model Incident {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  /// INC-2026-0001. Generated, because an incident gets referred to by number
  /// in correspondence with an inspector long after everyone has forgotten it.
  reference      String

  kind   IncidentKind
  status IncidentStatus @default(REPORTED)

  occurredAt DateTime @db.Timestamptz(6)
  /// When it reached this system, which is not when it happened. The gap
  /// between the two is itself a safety measurement.
  reportedAt DateTime @default(now()) @db.Timestamptz(6)

  /// The site. Null for the yard or the office, which are not projects.
  projectId String? @db.Uuid
  /// Whereabouts on it, in the words somebody would say over the radio.
  place     String?

  /// Who was hurt, when they are ours.
  injuredEmployeeId String? @db.Uuid
  /// Somebody hurt who is not on our payroll — a subcontractor's man, a
  /// delivery driver, a member of the public. A name rather than a link,
  /// because we hold no record of them, and neither reporting duty cares
  /// whose payroll they were on.
  injuredPersonName String?

  description     String
  /// What was done at the time: the first aid, the isolation, the make-safe.
  immediateAction String?

  /// Days the injured person could not do their normal work.
  ///
  /// A number rather than a note because the OHSA's reporting duty turns on
  /// fourteen of them. Null while it is not yet known, which is the usual
  /// state on the day — and "not yet known" is why the reporting clock is
  /// worked out fresh each time it is asked rather than stamped on once.
  daysUnableToWork Int?

  /// Section 24(1)(b) and (c) of the OHSA: a major incident, or a spillage,
  /// an uncontrolled release under pressure, machinery that fractured and
  /// threw something, or machinery that ran out of control.
  ///
  /// Reportable whether or not anybody was hurt, which is exactly why it
  /// cannot be derived from the injury and has to be asked.
  dangerousOccurrence Boolean @default(false)

  /// Filed with the Department of Employment and Labour (OHSA s24).
  reportedToDepartmentAt DateTime? @db.Timestamptz(6)
  /// Filed with the Compensation Fund (COIDA s39).
  reportedToFundAt       DateTime? @db.Timestamptz(6)
  /// Whatever reference the filing came back with, so it can be found again.
  externalReference      String?

  investigatedById String?   @db.Uuid
  rootCause        String?
  closedAt         DateTime? @db.Timestamptz(6)
  closedById       String?   @db.Uuid

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  injuredEmployee Employee?    @relation("IncidentInjured", fields: [injuredEmployeeId], references: [id], onDelete: SetNull)
  investigatedBy  User?        @relation("IncidentInvestigator", fields: [investigatedById], references: [id], onDelete: SetNull)
  closedBy        User?        @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)

  actions IncidentAction[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, occurredAt])
  @@index([projectId, occurredAt])
  @@map("incidents")
}

/// What is being done so it does not happen again.
///
/// Separate rows rather than a field on the incident, because an incident
/// usually needs several and they fall due at different times to different
/// people. An incident cannot be closed while one of these is open — that
/// rule is the only thing standing between an action register and a wish list.
model IncidentAction {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  incidentId     String @db.Uuid

  description String
  control     ControlType

  /// Who owes it. An employee rather than a user: the person who has to weld
  /// the handrail back on very often has no login.
  assignedToEmployeeId String?  @db.Uuid
  dueAt                DateTime @db.Timestamptz(6)

  completedAt   DateTime? @db.Timestamptz(6)
  completedById String?   @db.Uuid
  completedNote String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  incident           Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignedToEmployee Employee?    @relation("IncidentActionOwner", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  completedBy        User?        @relation("IncidentActionCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([incidentId])
  @@index([organisationId, dueAt])
  @@map("incident_actions")
}

// ---------------------------------------------------------------------------
// Procurement
// ---------------------------------------------------------------------------

/// Whether we are allowed to buy from them yet.
///
/// A register everybody can add to and nobody vets is how a company ends up
/// paying a supplier whose tax clearance lapsed two years ago — which on a
/// public-sector contract is the client's problem and therefore ours.
enum SupplierStatus {
  PENDING
  APPROVED
  SUSPENDED
}

/// The authorisation lifecycle of an order, and nothing else.
///
/// Deliberately says nothing about whether the goods have arrived. That is
/// derived from the receipts every time it is asked, because a stored
/// "received" flag and a receipts table disagree the first time somebody
/// records a late delivery, and then two screens give two answers.
///
/// DRAFT is the requisition. For a company of this size the order a site wants
/// and the request for it are the same piece of paper, and a separate
/// requisition table would be a second form to fill in that says the same
/// things. It becomes a commitment at APPROVED, not before.
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
}

/// Where a supplier's invoice has got to.
enum SupplierInvoiceStatus {
  RECEIVED
  APPROVED
  DISPUTED
  PAID
}

/// Somebody we buy from.
model Supplier {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  /// SUP-2026-0001.
  reference      String

  name               String
  tradingName        String?
  registrationNumber String?
  vatNumber          String?

  contactName String?
  email       String?
  phone       String?
  address     String?

  status SupplierStatus @default(PENDING)

  /// 1 to 8, or null when they have not given us a certificate.
  ///
  /// Held because preferential procurement is scored on the spend a contractor
  /// puts through B-BBEE compliant suppliers, and a tender asks for that split
  /// after the fact. Recording it at the supplier is the only way to answer
  /// without going through a year of invoices by hand.
  bbbeeLevel            Int?
  /// A supplier with no valid tax clearance is a problem you inherit.
  taxClearanceExpiresAt DateTime? @db.Timestamptz(6)

  /// What they supply, in the words the buyer uses — "readymix", "scaffolding
  /// hire", "PPE". Free text rather than an enum: a category list drawn up now
  /// would be wrong by the second supplier.
  supplies String[]

  notes String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@map("suppliers")
}

/// What we have asked a supplier for, and once approved, committed to paying.
model PurchaseOrder {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  /// PO-2026-0001. Quoted on the supplier's delivery note and their invoice,
  /// which is the whole reason a purchase order has a number.
  reference      String

  supplierId String  @db.Uuid
  /// The site it is for. Null for the yard and the office, which are not
  /// projects — and a purchase with no project is exactly the one nobody
  /// notices, so it is allowed but never silent.
  projectId  String? @db.Uuid

  status PurchaseOrderStatus @default(DRAFT)

  /// Free text, because it is read by a driver looking for a gate.
  deliverTo  String?
  requiredBy DateTime? @db.Timestamptz(6)
  currency   String    @default("ZAR")
  notes      String?

  submittedById  String?   @db.Uuid
  approvedById   String?   @db.Uuid
  approvedAt     DateTime? @db.Timestamptz(6)
  rejectedReason String?
  cancelledAt    DateTime? @db.Timestamptz(6)
  closedAt       DateTime? @db.Timestamptz(6)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  submittedBy  User?        @relation("PurchaseOrderSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices SupplierInvoice[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([supplierId])
  @@index([projectId, status])
  @@map("purchase_orders")
}

/// One thing being bought, at a price.
///
/// The order's total is the sum of these and is never stored. A stored total
/// is a second copy of a number that can be edited, and the first line change
/// that forgets to update it is undetectable.
model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  organisationId  String @db.Uuid
  purchaseOrderId String @db.Uuid

  /// The number the supplier will quote back on a query. Stable once written.
  lineNumber  Int
  description String
  /// "each", "m³", "tonne", "day". A word rather than an enum, because plant
  /// hire is billed in days and readymix in cubic metres and nobody agrees.
  unit        String @default("each")

  /// The item in the stock register this line buys, when it buys one.
  ///
  /// Optional and usually null. Plant hire, a subcontractor's labour and a
  /// skip are all ordinary purchase order lines that never sit on a shelf, and
  /// forcing every line to name a stock item would fill the register with
  /// things nobody counts. Set it, and the delivery puts itself away.
  stockItemId String? @db.Uuid

  /// Fractional on purpose: 12.5 m³ of concrete is an ordinary order, and an
  /// integer quantity would round it into a dispute.
  quantity       Decimal @db.Decimal(12, 3)
  unitPriceCents BigInt

  category ExpenseCategory @default(MATERIALS)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  receiptLines   GoodsReceiptLine[]
  stockMovements StockMovement[]

  @@unique([purchaseOrderId, lineNumber])
  @@index([organisationId])
  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

/// What actually turned up.
///
/// A separate record per delivery rather than a quantity on the line, because
/// partial delivery is the normal case on a construction site: half the
/// reinforcing arrives on Tuesday and the rest the following week, and both
/// need their own date and their own delivery note number.
model GoodsReceipt {
  id              String @id @default(uuid()) @db.Uuid
  organisationId  String @db.Uuid
  /// GRN-2026-0001.
  reference       String
  purchaseOrderId String @db.Uuid

  receivedAt           DateTime @db.Timestamptz(6)
  /// Theirs, off the paper the driver hands over.
  deliveryNoteNumber   String?
  /// Who took delivery. An employee, not a user: the storeman signing for a
  /// load of cement very often has no login.
  receivedByEmployeeId String?  @db.Uuid
  note                 String?

  /// Which store it was put away in.
  ///
  /// Null when the tenant does not run the inventory module, and null when the
  /// load went straight off the truck onto the slab — which is most readymix
  /// and most of the reinforcing on a busy site. A delivery that was never in
  /// a store must not appear in one, so nothing is put away without this.
  stockLocationId String? @db.Uuid

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation       Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  purchaseOrder      PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedByEmployee Employee?      @relation("GoodsReceiver", fields: [receivedByEmployeeId], references: [id], onDelete: SetNull)
  stockLocation      StockLocation? @relation(fields: [stockLocationId], references: [id], onDelete: SetNull)

  lines          GoodsReceiptLine[]
  stockMovements StockMovement[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

/// How much of one ordered line this delivery brought.
model GoodsReceiptLine {
  id                  String @id @default(uuid()) @db.Uuid
  organisationId      String @db.Uuid
  goodsReceiptId      String @db.Uuid
  /// Which ordered line it is against. Receiving something nobody ordered is
  /// a conversation with the supplier, not a row in here.
  purchaseOrderLineId String @db.Uuid

  /// What was accepted.
  quantity         Decimal @db.Decimal(12, 3)
  /// What was sent back — short-delivered, wet, cracked, wrong grade. Held
  /// apart from the accepted quantity because the two answer different
  /// questions: one is what we owe for, the other is what the supplier is
  /// still on the hook for.
  rejectedQuantity Decimal @default(0) @db.Decimal(12, 3)
  rejectedReason   String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

/// What the supplier says we owe.
///
/// One amount against the whole order rather than lines of its own. Line-level
/// invoice matching needs the supplier to invoice against your line numbers,
/// and no supplier does — they invoice off their own picking slip. Matching
/// value at the order and quantity at the line is what can actually be checked
/// against the paper that arrives.
model SupplierInvoice {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid

  supplierId      String @db.Uuid
  purchaseOrderId String @db.Uuid
  /// Theirs. The number to quote when querying it.
  invoiceNumber   String

  invoicedAt DateTime  @db.Timestamptz(6)
  dueAt      DateTime? @db.Timestamptz(6)

  /// Excluding VAT, so it can be compared with the order, which is also
  /// excluding VAT. Comparing a VAT-inclusive invoice with a VAT-exclusive
  /// order is the most common way a match is declared wrong when it is right.
  netAmountCents BigInt
  vatCents       BigInt @default(0)

  status         SupplierInvoiceStatus @default(RECEIVED)
  disputedReason String?
  paidAt         DateTime?             @db.Timestamptz(6)

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([organisationId, supplierId, invoiceNumber])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([purchaseOrderId])
  @@map("supplier_invoices")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// Why stock moved. Which side of the movement carries a location says which
/// way it went; this says what happened.
///
/// RECEIPT is the only kind that brings a price in with it — it comes off the
/// purchase order line the goods were delivered against. Everything else is
/// valued by replaying the ledger, which is why there is no cost column to
/// disagree with.
enum StockMovementKind {
  /// Delivered against a purchase order and put away.
  RECEIPT
  /// Out to a site, a job or a person. This is the one that consumes stock.
  ISSUE
  /// Back from a site unused.
  RETURN
  /// Between two of our own stores. Nothing is consumed and nothing is bought.
  TRANSFER
  /// The ledger corrected to agree with the shelf, after a count.
  ADJUSTMENT
  /// Damaged, expired, or gone. Deliberately not an adjustment: writing stock
  /// off is a decision somebody makes, and a correction is an arithmetic
  /// disagreement. Filing the first as the second is how theft looks like
  /// rounding.
  WRITE_OFF
}

/// Where a stocktake has got to.
enum StockCountStatus {
  /// Being counted. Nothing has moved.
  DRAFT
  /// Counted and handed in. The variance is frozen and waiting for somebody
  /// other than the counter to accept it.
  COUNTED
  /// Accepted. The adjustments are in the ledger and the count is history.
  ACCEPTED
  /// Given up on — a count nobody finished is worse than no count at all,
  /// because a half-counted store reads as a store full of losses.
  ABANDONED
}

/// Something we hold stock of.
///
/// Not everything bought is a stock item. Plant hire, a subcontractor's labour
/// and a skip are all purchase order lines that never sit on a shelf, so the
/// link from a purchase order line to an item is optional and most lines will
/// not have one. The register is for the things that are counted.
model StockItem {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  /// STK-2026-0001.
  reference      String

  /// The company's own code for it, as painted on the rack. Optional because
  /// plenty of contractors do not have one, and inventing codes for them is a
  /// week of work that buys nothing.
  code        String?
  name        String
  description String?

  /// How it is counted. The same free text a purchase order line uses — a bag
  /// of cement is "bag" and readymix is "m³", and a fixed list drawn up now
  /// would be wrong by the second item.
  unit     String          @default("each")
  category ExpenseCategory @default(MATERIALS)

  /// Below this, somebody should be buying more. Null means nobody has said,
  /// which is different from zero — zero is a deliberate "only order it when
  /// a job needs it", and a null must never raise an alert nobody asked for.
  reorderLevel    Decimal? @db.Decimal(12, 3)
  /// How much to buy when it does run low, so the reorder list is an order
  /// somebody can place rather than a list of names.
  reorderQuantity Decimal? @db.Decimal(12, 3)

  notes String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  movements  StockMovement[]
  countLines StockCountLine[]
  orderLines PurchaseOrderLine[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, category])
  @@map("stock_items")
}

/// Somewhere stock is kept.
///
/// The main yard, a container on a site, a lock-up at the office. A store on a
/// site carries its project, which is what lets "what is left on the Mamelodi
/// job" be a question with an answer when the job finishes.
model StockLocation {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid

  name      String
  /// Set when the store belongs to a site. Null is the yard and the office.
  projectId String? @db.Uuid
  address   String?

  /// Where a delivery lands when the person recording it does not say. Exactly
  /// one per tenant is enforced in the service — two defaults is a coin toss
  /// over where a load of cement went.
  isDefault Boolean @default(false)

  notes String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  movementsOut  StockMovement[] @relation("StockMovementFrom")
  movementsIn   StockMovement[] @relation("StockMovementTo")
  counts        StockCount[]
  goodsReceipts GoodsReceipt[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@index([projectId])
  @@map("stock_locations")
}

/// One thing that happened to stock.
///
/// The ledger. Stock on hand is the sum of these and is never stored anywhere
/// — the same decision the purchase order took about whether goods have
/// arrived, and for the same reason: a stored quantity and a movements table
/// disagree the first time somebody backdates a delivery, and then two screens
/// give two answers about how much cement is in the yard.
///
/// Direction is carried by which side has a location rather than by a sign on
/// the quantity. Stock coming in has a `to` and no `from`; stock going out has
/// a `from` and no `to`; a transfer has both. Quantities are therefore always
/// positive, and a negative quantity is a bug rather than a meaning.
model StockMovement {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  stockItemId    String @db.Uuid

  kind StockMovementKind

  fromLocationId String? @db.Uuid
  toLocationId   String? @db.Uuid

  /// Always positive. Fractional for the same reason a purchase order line is:
  /// 12.5 m³ of concrete is an ordinary delivery.
  quantity Decimal @db.Decimal(12, 3)

  /// What it came in at, on the movements that bring stock in and know the
  /// price — which in practice means a receipt, off the order it was delivered
  /// against. Null everywhere else, including on every issue: what stock
  /// leaves at is the running weighted average, and the average is computed
  /// from the ledger rather than written into it.
  unitCostCents BigInt?

  /// When it physically happened, which is not when somebody typed it in. A
  /// delivery signed for on Friday and captured on Monday belongs on Friday,
  /// or the Friday stock count is wrong forever.
  movedAt DateTime @db.Timestamptz(6)

  /// The delivery this came in on, when it came in on one.
  goodsReceiptId      String? @db.Uuid
  purchaseOrderLineId String? @db.Uuid
  /// What it was used on. Held on the movement rather than inferred from the
  /// store it left, because material is routinely drawn from the main yard
  /// straight onto a job.
  projectId           String? @db.Uuid
  /// Who took it. An employee, not a user — the person carrying twenty bags
  /// of cement out of the store very often has no login.
  issuedToEmployeeId  String? @db.Uuid
  /// The stocktake that produced this adjustment.
  stockCountId        String? @db.Uuid

  /// Why, in the words of whoever did it. Required by the service on the
  /// movements where "why" is the whole point — a write-off and an adjustment.
  reason String?
  note   String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stockItem         StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  fromLocation      StockLocation?     @relation("StockMovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation        StockLocation?     @relation("StockMovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  goodsReceipt      GoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issuedToEmployee  Employee?          @relation("StockIssuedTo", fields: [issuedToEmployeeId], references: [id], onDelete: SetNull)
  stockCount        StockCount?        @relation(fields: [stockCountId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, stockItemId, movedAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([projectId])
  @@map("stock_movements")
}

/// A stocktake: what was physically on the shelf, against what the ledger said.
///
/// The variance is the reason the module exists. A contractor who buys three
/// hundred thousand rand of material a month and never counts it has no idea
/// whether it went onto the job or into somebody's bakkie, and the difference
/// between those two is the whole margin.
model StockCount {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  /// SC-2026-0001.
  reference      String

  stockLocationId String   @db.Uuid
  countedOn       DateTime @db.Timestamptz(6)

  status StockCountStatus @default(DRAFT)

  /// Who walked the racks. An employee, for the same reason a delivery is
  /// signed for by one.
  countedByEmployeeId String? @db.Uuid
  /// Who handed it in, and who accepted the variance. Two different people,
  /// enforced in the service.
  submittedById       String? @db.Uuid
  acceptedById        String? @db.Uuid

  submittedAt     DateTime? @db.Timestamptz(6)
  acceptedAt      DateTime? @db.Timestamptz(6)
  abandonedReason String?

  note String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation      Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stockLocation     StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  countedByEmployee Employee?     @relation("StockCounter", fields: [countedByEmployeeId], references: [id], onDelete: SetNull)
  submittedBy       User?         @relation("StockCountSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  acceptedBy        User?         @relation("StockCountAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  lines       StockCountLine[]
  adjustments StockMovement[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([stockLocationId])
  @@map("stock_counts")
}

/// One item on a stocktake.
model StockCountLine {
  id             String @id @default(uuid()) @db.Uuid
  organisationId String @db.Uuid
  stockCountId   String @db.Uuid
  stockItemId    String @db.Uuid

  /// What was actually there.
  countedQuantity  Decimal @db.Decimal(12, 3)
  /// What the ledger said at the moment the count was handed in.
  ///
  /// Frozen rather than recomputed, and this is the important one. A variance
  /// recomputed on the fly changes every time anything moves, so the figure a
  /// manager accepted on Tuesday is not the figure the screen shows on
  /// Thursday — and the adjustment that was posted no longer reconciles to
  /// anything. Written once, when the count is submitted.
  expectedQuantity Decimal @db.Decimal(12, 3)

  note String?

  recordStatus RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  deletedAt    DateTime?    @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stockCount   StockCount   @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  /// organisationId leads the key so the tenancy extension can pin the upsert
  /// a count uses to one tenant. Without it the guard refuses the write, which
  /// is the extension doing its job rather than being awkward.
  @@unique([organisationId, stockCountId, stockItemId])
  @@index([organisationId])
  @@index([stockCountId])
  @@map("stock_count_lines")
}
